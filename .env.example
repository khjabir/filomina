# ──────────────────────────────────────────────────────────────
# Filomina — AI photo finder for a shared Google Drive
# Copy to .env.local and fill in what you need.
# ──────────────────────────────────────────────────────────────

# Public folders (no sign-in). Create an API key in Google Cloud Console,
# enable the "Google Drive API" and restrict the key to it.
GOOGLE_API_KEY=

# Default shared folder. Take the ID from the folder URL:
# https://drive.google.com/drive/folders/<THIS_PART>
# Optional – users can also paste a folder link in the app.
DRIVE_ROOT_FOLDER_ID=

# Private folders (Google sign-in). OAuth 2.0 "Web application" client.
# Authorised redirect URI must be:  <APP_URL>/api/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
APP_URL=http://localhost:3000

# 32+ random characters, used to encrypt the session cookie.
# e.g.  openssl rand -base64 32
SESSION_SECRET=

# Audit log admin (visit /audit). Leave empty to disable the admin viewer.
AUDIT_ADMIN_KEY=
# Days to keep uploaded search photos and audit entries.
AUDIT_RETENTION_DAYS=90
# Where audit entries, uploaded photos and the face index are stored.
DATA_DIR=./data

# Secret URL prefix for the admin area: https://<domain>/manage-<random>
# With this set, /admin and /audit answer 404 to everyone who does not know the prefix.
ADMIN_PATH=

# Shown in the privacy policy.
APP_OPERATOR_NAME=
PRIVACY_CONTACT_EMAIL=
NEXT_PUBLIC_APP_NAME=Filomina

# Try the app without Google credentials: serve a local folder of photos
# (nested sub-folders supported). Intended for development and testing.
# DRIVE_LOCAL_DIR=/path/to/photos

# Face engine (server-side). Models from `npm run fetch-models` (git-ignored).
FACE_MODELS_DIR=./models
FACE_INDEX_CONCURRENCY=2
FACE_THREADS=0

# ── Hosting on Vercel / serverless ─────────────────────────────────────
# Database: a Turso (libSQL) database. Leave empty to use the local SQLite file.
TURSO_DATABASE_URL=
TURSO_AUTH_TOKEN=
# Where the function downloads the models from at cold start (see `npm run upload-models`).
FACE_MODELS_URL=
FACE_MODEL_PACK=l
# How long one request may spend analysing photos (ms). Keep below the platform limit.
FACE_REQUEST_BUDGET_MS=240000
